# Konfigurasi Server SIMADU API
PORT=3000
NODE_ENV=development

# Konfigurasi JWT Bearer Token (Ganti dengan secret acak minimal 32 karakter di produksi)
JWT_SECRET=simadu-uin-antasari-2026-ganti-dengan-secret-kuat-minimal-32-karakter
JWT_EXPIRES_IN=1h

# Konfigurasi CORS (pisahkan dengan koma jika lebih dari satu origin, atau * untuk development)
CORS_ORIGIN=*
